{
  "name": "harry-notes",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:merge": "node node_modules/typescript/bin/tsc lib/textMerge.ts lib/textMerge.test.ts --outDir .test-out --module commonjs --target es2020 --lib es2020 && node .test-out/textMerge.test.js",
    "test:markdown": "node node_modules/typescript/bin/tsc components/notes/editor/markdownDom.test.ts --rootDir . --outDir .test-out-md --module commonjs --target es2020 --lib es2020,dom && node .test-out-md/components/notes/editor/markdownDom.test.js",
    "deploy": "node scripts/check-env.js && node node_modules/typescript/bin/tsc --noEmit && expo export --platform web --clear && node scripts/inject-pwa-head.js && npx wrangler pages deploy dist --project-name harry-notes --commit-dirty=true --branch=main"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "fuse.js": "^7.3.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "jimp": "^0.22.12",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
